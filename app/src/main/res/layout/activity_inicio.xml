<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pethealth"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_marginTop="30dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_pethealth_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/inicio_titulo"
            android:textColor="@color/rojo_oscuro"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/inicio_subtitulo"
            android:textColor="@color/texto_secundario"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card"
            android:elevation="3dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnMisMascotas"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/bg_opcion"
                android:backgroundTint="@null"
                android:text="@string/mis_mascotas"
                android:textColor="@color/rojo_oscuro"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRegistrarMascota"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_opcion"
                android:backgroundTint="@null"
                android:text="@string/registrar_mascota"
                android:textColor="@color/rojo_oscuro"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnProximosControles"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_opcion"
                android:backgroundTint="@null"
                android:text="@string/proximos_controles"
                android:textColor="@color/rojo_oscuro"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnVacunas"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_boton_rosado"
                android:backgroundTint="@null"
                android:text="@string/vacunas"
                android:textColor="@color/blanco"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
