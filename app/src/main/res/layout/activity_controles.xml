<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pethealth"
    android:padding="24dp">

    <!-- Botón Volver -->
    <Button
        android:id="@+id/btnVolverInicioControles"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:background="@drawable/bg_opcion"
        android:backgroundTint="@null"
        android:minWidth="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/volver_inicio"
        android:textAllCaps="false"
        android:textColor="@color/rojo_oscuro"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Título -->
    <TextView
        android:id="@+id/txtTituloControles"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/controles_titulo"
        android:textColor="@color/rojo_oscuro"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnVolverInicioControles" />

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/txtSubtituloControles"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/controles_subtitulo_avance14"
        android:textColor="@color/texto_secundario"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTituloControles" />

    <!-- RecyclerView para lista dinámica optimizada -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerControles"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/btnRegistrarControl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtSubtituloControles" />

    <!-- Mensaje de lista vacía -->
    <TextView
        android:id="@+id/txtSinProximosControles"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="18dp"
        android:text="@string/sin_proximos_controles"
        android:textColor="@color/texto_secundario"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btnRegistrarControl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtSubtituloControles" />

    <!-- Botón Registrar -->
    <Button
        android:id="@+id/btnRegistrarControl"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_boton_rojo"
        android:backgroundTint="@null"
        android:text="@string/registrar_control"
        android:textColor="@color/blanco"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/txtFooterSqlite"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Footer SQLite -->
    <TextView
        android:id="@+id/txtFooterSqlite"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/controles_sqlite_avance12"
        android:textColor="@color/texto_secundario"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>