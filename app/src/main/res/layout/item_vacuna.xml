<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card"
    android:elevation="2dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/txtItemVacunaMascota"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/rojo_oscuro"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtItemVacunaNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/texto_principal"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/txtItemVacunaFecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtItemVacunaEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/rojo_oscuro"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnItemVacunaVerMascota"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_opcion"
        android:backgroundTint="@null"
        android:text="@string/ver_mascota_vacuna"
        android:textColor="@color/rojo_oscuro"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnItemVacunaEditar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_boton_rosado"
            android:backgroundTint="@null"
            android:text="@string/editar"
            android:textColor="@color/blanco"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnItemVacunaEliminar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_boton_rojo"
            android:backgroundTint="@null"
            android:text="@string/eliminar"
            android:textColor="@color/blanco"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
