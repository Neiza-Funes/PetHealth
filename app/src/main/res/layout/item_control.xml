<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card"
    android:elevation="2dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/txtItemControlMascota"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/rojo_oscuro"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtItemControlTipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/texto_principal"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/txtItemControlFecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/txtItemControlEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/rojo_principal"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtItemControlObservacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnItemControlVerMascota"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_opcion"
        android:backgroundTint="@null"
        android:text="@string/ver_mascota_control"
        android:textColor="@color/rojo_oscuro"
        android:textStyle="bold" />

</LinearLayout>
