<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".DetalleMascotaActivity">

    <!-- Botón Volver -->
    <Button
        android:id="@+id/btnVolverMisMascotas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Volver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Imagen de la Mascota -->
    <ImageView
        android:id="@+id/imgFotoMascota"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnVolverMisMascotas"
        tools:src="@tools:sample/avatars" />

    <TextView
        android:id="@+id/txtEstadoFoto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgFotoMascota"
        tools:text="Sin foto" />

    <!-- Botones de Gestión de Foto -->
    <LinearLayout
        android:id="@+id/layoutBotonesFoto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtEstadoFoto">

        <Button
            android:id="@+id/btnTomarFoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="Tomar Foto" />

        <Button
            android:id="@+id/btnGuardarFoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="Guardar" />

        <Button
            android:id="@+id/btnEliminarFoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Eliminar Foto" />
    </LinearLayout>

    <!-- Datos Principales -->
    <TextView
        android:id="@+id/txtDetalleNombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutBotonesFoto"
        tools:text="Nombre Mascota" />

    <TextView
        android:id="@+id/txtDetalleEspecie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtDetalleNombre"
        tools:text="Especie: Perro" />

    <TextView
        android:id="@+id/txtDetalleEdad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtDetalleEspecie"
        tools:text="Edad: 3 años" />

    <TextView
        android:id="@+id/txtDetalleRaza"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtDetalleEdad"
        tools:text="Raza: Mestizo" />

    <!-- Contenedores invisibles o de soporte para historiales/controles (evitan errores de ID) -->
    <TextView android:id="@+id/txtHistorial1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" app:layout_constraintTop_toBottomOf="@id/txtDetalleRaza" app:layout_constraintStart_toStartOf="parent"/>
    <TextView android:id="@+id/txtHistorial2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" app:layout_constraintTop_toBottomOf="@id/txtHistorial1" app:layout_constraintStart_toStartOf="parent"/>
    <TextView android:id="@+id/txtHistorialVacio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" app:layout_constraintTop_toBottomOf="@id/txtHistorial2" app:layout_constraintStart_toStartOf="parent"/>

    <LinearLayout android:id="@+id/contenedorDetalleControles" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" app:layout_constraintTop_toBottomOf="@id/txtHistorialVacio"/>
    <TextView android:id="@+id/txtControlesVacio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" app:layout_constraintTop_toBottomOf="@id/contenedorDetalleControles" app:layout_constraintStart_toStartOf="parent"/>

    <LinearLayout android:id="@+id/contenedorDetalleVacunas" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" app:layout_constraintTop_toBottomOf="@id/txtControlesVacio"/>
    <TextView android:id="@+id/txtVacunasVacio" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" app:layout_constraintTop_toBottomOf="@id/contenedorDetalleVacunas" app:layout_constraintStart_toStartOf="parent"/>

    <!-- Botones Editar y Eliminar Mascota -->
    <Button
        android:id="@+id/btnEditarMascota"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp"
        android:text="Editar"
        app:layout_constraintEnd_toStartOf="@+id/btnEliminarMascota"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtVacunasVacio" />

    <Button
        android:id="@+id/btnEliminarMascota"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Eliminar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnEditarMascota"
        app:layout_constraintTop_toTopOf="@id/btnEditarMascota" />

</androidx.constraintlayout.widget.ConstraintLayout>