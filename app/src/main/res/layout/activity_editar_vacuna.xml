<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pethealth"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/btnVolverEditarVacuna"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_opcion"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/volver_inicio"
            android:textAllCaps="false"
            android:textColor="@color/rojo_oscuro"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/editar_vacuna_titulo"
            android:textColor="@color/rojo_oscuro"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/editar_vacuna_subtitulo"
            android:textColor="@color/texto_secundario"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/seleccionar_mascota_vacuna"
                android:textColor="@color/texto_principal"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerEditarMascotaVacuna"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/nombre_vacuna"
                android:textColor="@color/texto_principal"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtEditarNombreVacuna"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="@string/nombre_vacuna_hint"
                android:inputType="textCapSentences"
                android:paddingHorizontal="14dp"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/fecha_vacuna"
                android:textColor="@color/texto_principal"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtEditarFechaVacuna"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="@string/fecha_vacuna_hint"
                android:inputType="date"
                android:paddingHorizontal="14dp"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/estado_vacuna"
                android:textColor="@color/texto_principal"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerEditarEstadoVacuna"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input" />

            <Button
                android:id="@+id/btnGuardarCambiosVacuna"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_boton_rosado"
                android:backgroundTint="@null"
                android:text="@string/guardar_cambios_vacuna"
                android:textColor="@color/blanco"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
