<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pethealth"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <Button
            android:id="@+id/btnVolverEditarMascota"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_opcion"
            android:backgroundTint="@null"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="@string/volver_detalle_mascota"
            android:textColor="@color/rojo_oscuro"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_pethealth_logo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/editar_mascota_titulo"
            android:textColor="@color/rojo_oscuro"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/editar_mascota_subtitulo"
            android:textColor="@color/texto_secundario"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nombre_mascota"
                android:textColor="@color/texto_principal"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtNombreMascotaEditar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="@string/nombre_mascota_hint"
                android:inputType="textCapWords"
                android:paddingHorizontal="14dp"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/texto_secundario" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/especie_mascota"
                android:textColor="@color/texto_principal"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerEspecieEditar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/edad_mascota"
                android:textColor="@color/texto_principal"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtEdadMascotaEditar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="@string/edad_mascota_hint"
                android:inputType="number"
                android:paddingHorizontal="14dp"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/texto_secundario" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/raza_mascota"
                android:textColor="@color/texto_principal"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtRazaMascotaEditar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="@string/raza_mascota_hint"
                android:inputType="textCapWords"
                android:paddingHorizontal="14dp"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/texto_secundario" />

            <Button
                android:id="@+id/btnGuardarCambiosMascota"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_boton_rojo"
                android:backgroundTint="@null"
                android:text="@string/guardar_cambios_mascota"
                android:textColor="@color/blanco"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
